[Unit]
Description=Audiobook Player (Arcade Box)
Documentation=https://github.com/Lioninside/audiobookplayerbox
# Start after audio and basic networking are ready
After=sound.target multi-user.target
Wants=sound.target

[Service]
Type=simple
User=pi
Group=pi

WorkingDirectory=/home/pi

# Full path to the script — adjust if you clone to a different location
ExecStart=/usr/bin/python3 /home/pi/audiobookplayerbox/player.py

# Restart automatically on any failure or unexpected exit
Restart=always
RestartSec=3

# Give the audio hardware a moment after a crash before restarting
StartLimitIntervalSec=60
StartLimitBurst=10

# Forward stdout/stderr to the system journal (viewable with: journalctl -u audiobook -f)
StandardOutput=journal
StandardError=journal

# Environment for audio via ALSA/PulseAudio under the pi user
Environment=DISPLAY=:0
Environment=HOME=/home/pi

[Install]
WantedBy=multi-user.target
