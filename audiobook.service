[Unit]
Description=Audiobook Player (Arcade Box)
Documentation=https://github.com/Lioninside/audiobookplayerbox
# Start after audio and basic networking are ready
After=sound.target multi-user.target
Wants=sound.target

[Service]
Type=simple
User=radonthusis
Group=radonthusis

WorkingDirectory=/home/radonthusis

# Full path to the script — adjust if you clone to a different location
ExecStart=/usr/bin/python3 /home/radonthusis/audiobookplayerbox/player.py

# Restart automatically on any failure or unexpected exit
Restart=always
RestartSec=3

# Disable systemd's restart rate-limiting entirely.
# With the default (burst=5 in 10 s), systemd stops retrying after a few
# rapid crashes and the box goes permanently silent. For an always-on
# appliance that must recover from any failure, unlimited retries are correct.
# RestartSec=3 already prevents a tight CPU-burning crash loop.
StartLimitIntervalSec=0

# Forward stdout/stderr to the system journal (viewable with: journalctl -u audiobook -f)
StandardOutput=journal
StandardError=journal

# Environment for audio via ALSA/PulseAudio
Environment=DISPLAY=:0
Environment=HOME=/home/radonthusis

[Install]
WantedBy=multi-user.target
